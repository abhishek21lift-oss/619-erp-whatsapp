# 619-erp-whatsapp — environment template
#
# Copy to .env for local development. NEVER commit .env (see .gitignore).
# In production every value comes from /opt/myptstudio/.env on the VPS and is
# injected by compose — nothing is baked into the image.

# ── Runtime ─────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=8080
# 0.0.0.0 is correct inside a container and is NOT a public exposure: the
# service publishes no host port, so the Docker network is the only way in.
HOST=0.0.0.0
# Never `debug` in production — see src/logger.ts. Redaction covers the paths we
# know about; debug turns on Baileys protocol logging, which is a much wider
# surface than a deny-list can promise to cover.
LOG_LEVEL=info

# ── Secrets — REQUIRED, the process refuses to start without them ───────────
#
# Generate each with:  openssl rand -hex 32
# WA_GATEWAY_KEY and WA_WEBHOOK_SECRET must MATCH the values set on the backend.

# Authenticates the backend → gateway hop.
WA_GATEWAY_KEY=

# Signs the gateway → backend webhook (HMAC-SHA256).
WA_WEBHOOK_SECRET=

# ── The one host this service ever calls outbound ───────────────────────────
# Fixed configuration, deliberately: no caller-supplied URL is ever fetched.
WA_BACKEND_URL=http://myptstudio-backend:5000

# ── Redis — a HARD dependency here, unlike in the ERP ───────────────────────
# QR storage, the event outbox and the single-owner instance lock all need it.
REDIS_URL=redis://redis:6379

# ── Storage (all on the persistent volume) ──────────────────────────────────
WA_SESSION_DIR=/data/sessions
WA_MANIFEST_PATH=/data/instances.json
WA_QUARANTINE_DIR=/data/quarantine

# ── Limits ──────────────────────────────────────────────────────────────────
# PLACEHOLDER. Phase 9 measures real per-instance memory and this is set from
# that measurement — do not ship this default untested.
WA_MAX_INSTANCES=50

WA_QR_TTL_SEC=60
WA_QR_MAX_ROUNDS=5

# Watchdog for a socket that produces NO event at all — no QR, no close, no
# error. Baileys does not reliably surface that case (found in Phase 3 against a
# network that blocks WhatsApp), and without this an instance sits in
# `connecting` forever while the studio watches a spinner.
WA_CONNECT_TIMEOUT_MS=45000

# Which connector backs the service: `baileys` (production) or `null` (the whole
# service runs — auth, tenancy, manifest, events — with pairing inert, so the
# gateway can be stood up alongside a backend whose feature flag is still off).
WA_CONNECTOR=baileys

WA_RECONNECT_BASE_MS=2000
WA_RECONNECT_MAX_MS=300000
WA_RECONNECT_MAX_ATTEMPTS=10

WA_QUARANTINE_RETENTION_DAYS=7

# Per-organization API rate limit. Guards against a backend bug (a runaway poll
# loop), not against an attacker — who cannot reach this service at all.
WA_RATE_LIMIT_MAX=100
WA_RATE_LIMIT_WINDOW_MS=60000
