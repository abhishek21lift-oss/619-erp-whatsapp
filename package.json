{
  "name": "619-erp-whatsapp",
  "version": "0.1.0",
  "private": true,
  "description": "Self-hosted WhatsApp gateway for MY PT STUDIO / 619 Fitness ERP",
  "license": "UNLICENSED",
  "type": "module",
  "main": "dist/server.js",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "typecheck": "tsc -p tsconfig.check.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@fastify/rate-limit": "^11.2.2",
    "baileys": "7.0.0-rc14",
    "fastify": "^5.12.8",
    "ioredis": "6.0.0",
    "pino": "^10.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "globals": "^17.14.0",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^7.3.8",
    "vitest": "^5.1.0"
  }
}
